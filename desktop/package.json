{
  "name": "notes",
  "productName": "Notes",
  "version": "1.0.0",
  "description": "Notes pour PC, synchronisées avec le téléphone",
  "main": "main.js",
  "private": true,
  "scripts": {
    "www": "node -e \"const f=require('fs');f.rmSync('www',{recursive:true,force:true});f.cpSync('../app/src/main/assets/www','www',{recursive:true})\"",
    "start": "npm run www && electron .",
    "dist": "npm run www && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "be.alexandre.notes.pc",
    "productName": "Notes",
    "artifactName": "Notes-PC-Setup-${version}.${ext}",
    "files": ["main.js", "preload.js", "icon.png", "www/**/*"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notes",
      "deleteAppDataOnUninstall": false
    }
  }
}
